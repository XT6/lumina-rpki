ta.cer
	ca1.cer
		roa1.roa
	ca2.cer
		roa2.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.cer]
# A host that can never resolve (RFC 6761 reserves .invalid). Its files
# are generated under rsync/unreachable/ but never served.
rpp.uri = rsync://unreachable.invalid/repo/ca1
rpp.path = unreachable/ca1
