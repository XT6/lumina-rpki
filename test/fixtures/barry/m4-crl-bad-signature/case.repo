ta.cer
	ca1.cer
		ca1.crl

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.crl]
# Barry doesn't sign when the signature is overridden. 256 octets, below
# any 2048-bit modulus, so only the comparison fails.
obj.signature = 
