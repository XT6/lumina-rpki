ta.cer
	ca1.cer
		roa1.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: roa1.roa]
# 256 octets, the length the 2048-bit EE key needs, that aren't its signature.
obj.content.signerInfos.0.signature = 
