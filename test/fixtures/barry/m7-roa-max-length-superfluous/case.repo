ta.cer
	ca1.cer
		roa1.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: roa1.roa]
# maxLength equal to the prefix length: allowed, but SHOULD NOT be encoded.
obj.content.encapContentInfo.eContent.ipAddrBlocks = [ 1.1.0.0/16-16, 0101::/16 ]
