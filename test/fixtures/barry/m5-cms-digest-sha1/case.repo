ta.cer
	ca1.cer
		roa1.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: roa1.roa]
# RFC 7935 section 2: SHA-256 MUST be used for the SignerInfo digestAlgorithm.
obj.content.signerInfos.0.digestAlgorithm.algorithm = 1.3.14.3.2.26
