ta.cer
	ca1.cer

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.cer]
# Barry's default CA list plus a non-critical EKU naming id-kp-bgpsec-router
# (1.3.6.1.5.5.7.3.30), as a router certificate would carry.
obj.tbsCertificate.extensions = [ bc, ski, aki, ku, eku, cdp, aia, sia, cp, ip, as ]
obj.tbsCertificate.extensions.eku.critical = false
obj.tbsCertificate.extensions.eku.extnValue = [ 1.3.6.1.5.5.7.3.30 ]
