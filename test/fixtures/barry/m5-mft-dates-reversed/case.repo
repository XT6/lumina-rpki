ta.cer
	ca1.cer
		ca1.mft
		roa1.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.mft]
# RFC 9286 section 4.4 item 3: thisUpdate precedes nextUpdate.
obj.content.encapContentInfo.eContent.thisUpdate = 2027-01-01T00:00:00Z
obj.content.encapContentInfo.eContent.nextUpdate = 2026-06-01T00:00:00Z
