ta.cer
	ca1.cer

[node: ca1.cer]
# Barry's default CA list plus a second Basic Constraints whose OID is
# changed to one no validator recognizes. Basic Constraints is critical.
obj.tbsCertificate.extensions = [ bc, ski, aki, ku, cdp, aia, sia, cp, ip, as, bc2 ]
obj.tbsCertificate.extensions.bc2.extnID = 1.3.6.1.4.1.99999.1
obj.tbsCertificate.extensions.bc2.critical = true
