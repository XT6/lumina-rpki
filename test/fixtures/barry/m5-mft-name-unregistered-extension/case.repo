ta.cer
	ca1.cer
		ca1.mft
		roa1.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.mft]
# RFC 9286 section 4.2.2: the extension must be in the IANA registry.
obj.content.encapContentInfo.eContent.fileList.0.file = roa1.xyz
