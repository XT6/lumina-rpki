ta.cer
	ca1.cer
		ca1.mft
		roa1.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.mft]
# RFC 9286 section 7 and erratum 7118: a manifest lists at least one file.
obj.content.encapContentInfo.eContent.fileList = []
