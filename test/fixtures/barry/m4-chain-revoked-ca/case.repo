ta.cer
	ca1.cer
	ca2.cer
	ta.crl

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.cer]
obj.tbsCertificate.serialNumber = 10

[node: ca2.cer]
obj.tbsCertificate.serialNumber = 20

[node: ta.crl]
# Revokes ca1 (D-021); Barry signs the CRL.
obj.tbsCertList.revokedCertificates = [ 10 ]
