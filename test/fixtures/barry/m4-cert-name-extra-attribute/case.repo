ta.cer
	ca1.cer
		roa1.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.cer]
obj.tbsCertificate.subject.rdnSequence = [
	[
		{ type = 2.5.4.3, value = ca1 },
		{ type = 2.5.4.10, value = Example }
	]
]
