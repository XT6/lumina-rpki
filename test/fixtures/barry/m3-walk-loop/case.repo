ta.cer
	ca1.cer
		ca2.cer

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca2.cer]
# ca2 names its parent's publication point as its own. Walking it finds
# ca2.cer again: the walk must notice the loop and stop.
rpp.uri = rsync://localhost:8873/rpki/ca1
rpp.path = ca1
