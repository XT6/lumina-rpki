ta.cer
	ca1.cer
		ca1.crl

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.crl]
# AKI, CRL Number, and a second CRL Number whose OID is changed to an
# unknown one, non-critical.
obj.tbsCertList.crlExtensions = [ aki, cn, cn2 ]
obj.tbsCertList.crlExtensions.cn2.extnID = 1.3.6.1.4.1.99999.3
obj.tbsCertList.crlExtensions.cn2.critical = false
