ta.cer
	ca1.cer
		ca1.mft
		roa1.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.mft]
# The ROA is listed as roa2.roa, which doesn't exist (roa1.roa is then simply unlisted).
obj.content.encapContentInfo.eContent.fileList.0.file = roa2.roa
