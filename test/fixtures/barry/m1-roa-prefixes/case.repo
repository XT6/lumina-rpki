ta.cer
	ca1.cer
		roa1.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: roa1.roa]
# Inside the EE certificate's default resources (1.1.0.0/16, 0101::/16),
# in canonical order, with and without maxLength.
obj.content.encapContentInfo.eContent.asId = 64496
obj.content.encapContentInfo.eContent.ipAddrBlocks = [ 1.1.0.0/17-24, 1.1.128.0/24, 0101::/16-48 ]
