ta.cer
	ca1.cer

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.cer]
# 1 followed by 20 zero octets: positive, 21 octets as a DER INTEGER.
obj.tbsCertificate.serialNumber = 0x010000000000000000000000000000000000000000
