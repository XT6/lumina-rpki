ta.cer
	ca1.cer
		ca1.mft
		roa1.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: ca1.mft]
# 32 octets that aren't roa1.roa's SHA-256.
obj.content.encapContentInfo.eContent.fileList.0.hash = 0x0101010101010101010101010101010101010101010101010101010101010101
