ta.cer
	ca1.cer
		roa1.roa
		roa2.roa

[node: ta.cer]
# Barry gives the root serial 0; RFC 6487 section 4.2 requires a positive one (F-029).
obj.tbsCertificate.serialNumber = 1

[node: roa1.roa]
# 1.2.0.0/16 is not in the EE certificate's 1.1.0.0/16.
obj.content.encapContentInfo.eContent.ipAddrBlocks = [ 1.1.0.0/16, 1.2.0.0/16, 0101::/16 ]
