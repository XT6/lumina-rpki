# Auto detect text files and perform LF normalization
* text=auto

# RPKI objects are DER-encoded binaries; never normalize line endings.
*.cer binary
*.crl binary
*.mft binary
*.roa binary
*.gbr binary
*.asa binary
*.sig binary
*.tak binary

# Test TALs are byte-exact: CRLF line ends and trailing whitespace are
# part of what they test, so git must never convert them.
test/fixtures/tals/** -text
